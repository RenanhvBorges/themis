# Postgres. Em desenvolvimento local aponte para um Postgres local; em
# produção/homologação, para a connection string do projeto Supabase, modo
# "Transaction" (Settings -> Database -> Connection string -> URI), porta
# 6543 — é a que o app usa em runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/themis?schema=public"

# Só em produção/homologação: connection string do Supabase em modo
# "Session"/direto, porta 5432 (mesma tela, aba "Direct connection"). O
# PgBouncer da porta 6543 acima não sustenta o advisory lock que o
# `prisma migrate deploy` precisa durante o build — sem essa variável o
# deploy falha ao tentar aplicar as migrations. Em desenvolvimento local
# pode repetir o valor de DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/themis?schema=public"

# Segredo usado para assinar os cookies de sessão (JWT). Gere com:
#   openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"
